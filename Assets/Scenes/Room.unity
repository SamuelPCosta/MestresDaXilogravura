  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 69edfeb99997f7a47ac3a562c739be5b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Xilo.Runtime::Xilo.UI.StepTextView
  flow: {fileID: 1485862683}
  titleLabel: {fileID: 738315164}
  instructionLabel: {fileID: 1435741680464596807}
  texts:
  - step: 0
    title: Escolha a arte
    instruction: "Navegue pelas artes e escolha a que voc\xEA quer gravar."
  - step: 1
    title: Desenho
    instruction: "Pegue o l\xE1pis e passe sobre o desenho na matriz."
  - step: 2
    title: Entalhe
    instruction: "Pegue a goiva e entalhe as \xE1reas da matriz."
  - step: 3
    title: Lixamento
    instruction: Pegue a lixa e passe sobre toda a matriz.
  - step: 4
    title: Tinta
    instruction: "Pegue o pote e incline-o sobre o acr\xEDlico."
  - step: 5
    title: Rolo
    instruction: "Passe o rolo sobre a tinta no acr\xEDlico."
  - step: 6
    title: Entintagem
    instruction: Passe o rolo carregado sobre toda a matriz.
  - step: 7
    title: Papel
    instruction: Pegue uma folha e coloque sobre a matriz.
  - step: 8
    title: "Impress\xE3o"
    instruction: "Esfregue o bar\xE9m sobre o papel."
  - step: 9
    title: Arte pronta
    instruction: Veja o resultado e escolha se quer salvar.
